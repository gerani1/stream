# ---- Board API ----
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# Signed session tokens (wallet auth). Generate: openssl rand -hex 32
JWT_SECRET=replace-me

# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/board?schema=public

# ---- Redis / jobs ----
REDIS_URL=redis://localhost:6379

# ---- Stacks ----
STACKS_NETWORK=testnet
HIRO_API_URL=https://api.testnet.hiro.so
CHAINHOOK_WEBHOOK_SECRET=replace-me

# ---- StackStream ----
# "mock"  -> MockStreamProvider (simulated time, no chain)
# "stackstream" -> real adapter (requires the settled integration shape)
STREAM_PROVIDER=mock
STACKSTREAM_API_URL=
STACKSTREAM_API_KEY=
STACKSTREAM_CONTRACT_ADDRESS=

# ---- Policy defaults (see README > Open questions) ----
BOUNTY_PAUSE_COOLOFF_DAYS=7
MIN_REVIEW_CYCLES_WARNING=3
