{
  "name": "stackstream-bounty-board",
  "private": true,
  "version": "0.1.0",
  "description": "Non-custodial front end for StackStream: bounty and cohort accelerator streams on Stacks",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:api": "npm run dev --workspace @board/api",
    "dev:web": "npm run dev --workspace @board/web",
    "db:migrate": "npm run db:migrate --workspace @board/api",
    "db:generate": "npm run db:generate --workspace @board/api"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "tsx": "^4.19.2",
    "@types/node": "^22.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
